{
  "name": "api",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint",
    "format": "prettier --write \"**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio --port 3002"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@workspace/typescript-config": "workspace:*",
    "pino-pretty": "^13.2.0",
    "prisma": "7.10.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/swagger": "^9.9.4",
    "@fastify/swagger-ui": "^6.1.3",
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "dotenv": "^18.0.10",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "fastify-zod-openapi": "^5.7.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.2"
  }
}
